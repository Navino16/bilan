{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "schedule:weekly"],
  "timezone": "Europe/Paris",
  "baseBranchPatterns": ["develop"],
  "labels": ["dependencies"],
  "dependencyDashboard": { "enabled": false },
  "prHourlyLimit": 0,
  "prConcurrentLimit": 20,
  "minimumReleaseAge": "1 day",
  "internalChecksFilter": "strict",
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "Minor and patch updates grouped per ecosystem; majors get their own PR",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "code dependencies"
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "CI dependencies"
    },
    {
      "matchManagers": ["dockerfile", "docker-compose"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "docker dependencies"
    },
    {
      "description": "Track the Node 24 runtime (engines.node); TypeScript 7 isn't supported by typescript-eslint yet",
      "matchPackageNames": ["@types/node", "typescript", "node"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "The CI E2E container image must match the @playwright/test version",
      "matchPackageNames": ["@playwright/test", "mcr.microsoft.com/playwright"],
      "groupName": "playwright"
    }
  ]
}
