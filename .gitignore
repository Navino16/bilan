# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
.reports/
playwright-report/
test-results/

# next.js
/.next/
/out/

# production
/build
dist/

# misc
.DS_Store
Thumbs.db
*.pem
*.tsbuildinfo
next-env.d.ts

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.*.local

# editor / OS
.idea/
*:Zone.Identifier
*.Zone.Identifier

# vercel
.vercel

# ---- Project-specific (DO NOT publish) ----
# Brainstorm mockups (local only)
.superpowers/
# MariaDB keyring (generated locally by scripts/init.sh)
docker/mariadb/keyring/

# Playwright MCP debug artifacts
.playwright-mcp/

# Playwright authenticated storageState (generated by auth.setup.ts)
tests/e2e/.auth

# Local design reference drops
/img.png

# Local dev-only seed helper (per user request, never commit)
scripts/seed-dev-user.ts
