{
  "name": "bilan",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && prettier --check .",
    "format": "eslint . --fix && prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "setup": "bash scripts/init.sh",
    "ci": "npm run lint && npm run typecheck && npm run test",
    "db:up": "docker compose up -d mariadb mariadb-test",
    "db:backup-dev": "bash scripts/backup-dev.sh",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "db:seed-dev": "tsx --env-file=.env scripts/seed-dev-user.ts",
    "db:reindex-search": "tsx --env-file=.env scripts/reindex-search-tokens.ts",
    "icons": "tsx scripts/generate-icons.ts",
    "docs:db": "bash scripts/docs-db.sh",
    "docs:screenshots": "tsx scripts/docs-screenshots.ts",
    "perf:db": "bash scripts/perf/db.sh",
    "perf:build": "bash scripts/perf/build.sh",
    "perf:bench": "node scripts/perf/bench.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/passkey": "~1.7.11",
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-auth": "~1.7.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.8",
    "envalid": "^8.2.0",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "next-intl": "^4.14.9",
    "nodemailer": "^10.1.7",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "^6.4.299",
    "re2js": "^2.8.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "^4.22.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "uqr": "^0.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "^4.14.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.2",
    "prettier": "^3",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.10.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "postcss": "^8.5.31",
    "@hono/node-server": "^1.19.13",
    "@better-auth/core": "1.7.11",
    "eslint-plugin-import": {
      "eslint": "$eslint"
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
