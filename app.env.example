# App and cron settings for docker-compose.prod.yml (README "Self-hosting"). Copy to app.env.
# Every variable is mandatory.

# Public HTTPS URL of the TLS reverse proxy in front of the app (plain HTTP does not work).
APP_URL=https://bilan.example.com

# openssl rand -base64 32 (one value each)
AUTH_SECRET=
DATA_ENCRYPTION_KEY=
SEARCH_TOKEN_KEY=
CRON_SECRET=

# Same password as MARIADB_PASSWORD in db.env. Pool size (default 10): append ?connectionLimit=20
DATABASE_URL=mysql://bilan:<MARIADB_PASSWORD>@mariadb:3306/bilan
