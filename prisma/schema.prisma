// Bilan — Group A schema: Identity (Better Auth) + RBAC
// Later phases add Groups B–H models (groups, accounts, categories, transactions, budgets, …).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ─── Better Auth core ────────────────────────────────────────────────────────

model User {
  id               String    @id
  email            String    @unique
  emailVerified    Boolean   @default(false)
  name             String?
  image            String?
  twoFactorEnabled Boolean   @default(false)
  role             String? // Better Auth admin plugin (admin | user); RBAC permissions live in UserRole.
  banned           Boolean   @default(false)
  banReason        String?
  banExpires       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sessions         Session[]
  authAccounts     AuthAccount[]
  twoFactors       TwoFactor[]
  passkeys         Passkey[]
  roles            UserRole[]
  preference       UserPreference?
  accounts         BankAccount[]        @relation("AccountOwner")
  groupMemberships GroupMember[]
  sentInvitations  GroupInvitation[]    @relation("InvitedBy")
  categories       Category[]
  rules            CategorizationRule[]
  budgets          Budget[]
}

model Session {
  id             String   @id
  userId         String
  token          String   @unique
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?  @db.Text
  impersonatedBy String? // Better Auth admin plugin (set during impersonation).
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Renamed from Better Auth's "Account" to avoid confusion with BankAccount (Group C).
model AuthAccount {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model TwoFactor {
  id          String  @id
  userId      String
  secret      String  @db.Text
  backupCodes String  @db.Text
  verified    Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Passkey {
  id           String   @id
  name         String?
  publicKey    String   @db.Text
  userId       String
  credentialID String
  counter      Int      @default(0)
  deviceType   String
  backedUp     Boolean  @default(false)
  transports   String?
  aaguid       String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── RBAC ────────────────────────────────────────────────────────────────────

model Role {
  id          String  @id @default(cuid())
  key         String  @unique // SUPER_ADMIN, ADMIN, USER
  name        String
  description String?
  isSystem    Boolean @default(false)

  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String @id @default(cuid())
  key         String @unique // admin.settings.write, admin.users.read, …
  scope       String // admin | system
  description String

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  userId    String
  roleId    String
  grantedAt DateTime @default(now())
  grantedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

// ─── App configuration, audit & signup tokens (Phase 1) ──────────────────────

model UserPreference {
  userId          String  @id
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  locale          String  @default("fr")
  theme           String  @default("system")
  linkWindowDays  Int     @default(30)
  linkMinAmount   Decimal @default(0) @db.Decimal(12, 2)
  dashboardLayout Json?
}

model AuthProvider {
  id              String   @id @default(cuid())
  type            String // credentials | oidc | google
  key             String   @unique
  displayName     String
  enabled         Boolean  @default(false)
  issuer          String?
  clientId        String?
  clientSecretEnc String?  @db.Text
  scopes          String?
  config          Json?
  updatedAt       DateTime @updatedAt
  updatedById     String?
}

model SmtpConfig {
  id          String   @id @default(cuid())
  host        String
  port        Int
  secure      Boolean  @default(true)
  username    String
  passwordEnc String   @db.Text
  fromAddress String
  fromName    String?
  enabled     Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  updatedById String?
}

model AppSetting {
  key         String   @id
  value       Json
  isSecret    Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  updatedById String?
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?  @db.Text
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entity, entityId])
  @@index([action, createdAt])
}

model AdminSignupToken {
  id          String    @id @default(cuid())
  token       String    @unique
  description String?
  maxUses     Int?
  usedCount   Int       @default(0)
  expiresAt   DateTime?
  createdById String
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?
}

// ─── Group C — Bank accounts (Phase 2) ───────────────────────────────────────

model BankAccount {
  id             String   @id @default(cuid())
  ownerId        String
  name           String
  type           String // CHECKING | SAVINGS | CREDIT | OTHER
  initialBalance Decimal  @default(0) @db.Decimal(12, 2) // CLEAR — opening balance; transactions add to it (Phase 3+)
  ibanEnc        String?  @db.Text // AES-256-GCM (v1.iv.ct.tag)
  ibanHash       String? // HMAC-SHA256 blind index for equality search
  bankName       String?
  color          String?  @default("#2563eb")
  icon           String?
  archived       Boolean  @default(false)
  createdAt      DateTime @default(now())

  owner        User           @relation("AccountOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  shares       AccountShare[]
  transactions Transaction[]
  imports      ImportBatch[]
  budgetLines  BudgetLine[]

  @@index([ownerId])
  @@index([ibanHash])
}

// ─── Group B — Households & membership (Phase 2) ─────────────────────────────

model Group {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdById String
  createdAt   DateTime @default(now())
  archived    Boolean  @default(false)

  members       GroupMember[]
  invitations   GroupInvitation[]
  accountShares AccountShare[]
  categories    Category[]
  rules         CategorizationRule[]
  budgets       Budget[]
}

model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  role     String // OWNER | ADMIN | MEMBER
  joinedAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

model GroupInvitation {
  id           String    @id @default(cuid())
  groupId      String
  email        String
  invitedById  String
  role         String    @default("MEMBER")
  token        String    @unique
  code         String    @unique
  expiresAt    DateTime
  acceptedAt   DateTime?
  acceptedById String?
  createdAt    DateTime  @default(now())

  group     Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  invitedBy User  @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([groupId])
}

model AccountShare {
  id          String   @id @default(cuid())
  accountId   String
  groupId     String
  permission  String // READ | WRITE
  createdById String
  createdAt   DateTime @default(now())

  account BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  group   Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([accountId, groupId])
  @@index([groupId])
}

model Category {
  id           String               @id @default(cuid())
  name         String
  color        String?
  icon         String?
  parentId     String?
  parent       Category?            @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[]           @relation("CategoryHierarchy")
  transactions Transaction[]
  rules        CategorizationRule[]
  budgetLines  BudgetLine[]

  // Owner XOR (User or Group) — enforced at the service layer (a DB CHECK is
  // impossible on MariaDB: error 1901 on a FK column with a referential action).
  userId  String?
  groupId String?
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([groupId])
  @@index([parentId])
}

// ─── Group D — Transactions (Phase 3) ────────────────────────────────────────

model Transaction {
  id        String   @id @default(cuid())
  accountId String
  date      DateTime
  amount    Decimal  @db.Decimal(12, 2)
  type      String // CARD | TRANSFER | DIRECT_DEBIT | CHEQUE | ATM | OTHER

  labelEnc     String  @db.Text
  labelHash    String
  rawLabelEnc  String  @db.Text
  rawLabelHash String
  noteEnc      String? @db.Text

  categoryId          String?
  category            Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  manuallyCategorized Boolean   @default(false)

  externalId  String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  importBatchId String?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  account        BankAccount              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  searchTokens   TransactionSearchToken[]
  linkMembership TransactionLinkMember?
  budgetAssignments BudgetAssignment[]

  @@unique([accountId, externalId])
  @@index([accountId, date])
  @@index([categoryId, date])
  @@index([labelHash])
  @@index([rawLabelHash])
  @@index([date])
  @@index([importBatchId])
}

model TransactionSearchToken {
  id            String      @id @default(cuid())
  transactionId String
  tokenHash     String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([transactionId])
}

model ImportBatch {
  id           String    @id @default(cuid())
  accountId    String
  source       String // CSV | PDF | MANUAL
  filename     String?
  filenameHash String?
  status       String // PENDING | PARSING | REVIEW | COMPLETED | FAILED
  totalRows    Int       @default(0)
  importedRows Int       @default(0)
  skippedRows  Int       @default(0)
  errorMessage String?
  metadata     Json?
  createdById  String
  createdAt    DateTime  @default(now())
  completedAt  DateTime?

  account      BankAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([accountId, createdAt])
}

model CategorizationRule {
  id            String  @id @default(cuid())
  pattern       String
  matchType     String // CONTAINS | EXACT | STARTS_WITH | REGEX
  caseSensitive Boolean @default(false)
  priority      Int     @default(100)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  // Scope XOR (User or Group) — enforced at the service layer (a DB CHECK is
  // impossible on MariaDB: error 1901 on a FK column with a referential action).
  userId  String?
  groupId String?
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([groupId])
  @@index([categoryId])
}

model TransactionLink {
  id          String   @id @default(cuid())
  name        String?
  createdById String
  createdAt   DateTime @default(now())

  members TransactionLinkMember[]

  @@index([createdById])
}

model TransactionLinkMember {
  linkId        String
  transactionId String   @unique // a transaction belongs to at most one link
  joinedAt      DateTime @default(now())

  link        TransactionLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  transaction Transaction     @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@id([linkId, transactionId])
  @@index([linkId])
}

model IgnoredLinkSuggestion {
  userId    String
  pairKey   String // canonical "txid1|txid2" (ids sorted)
  ignoredAt DateTime @default(now())

  @@id([userId, pairKey])
  @@index([userId])
}

// ─── Group G — Budgets (Phase 7) ─────────────────────────────────────────────

model Budget {
  id          String  @id @default(cuid())
  name        String
  description String?

  // Owner XOR (User or Group) — enforced at the service layer (a DB CHECK is
  // impossible on MariaDB: error 1901 on a FK column with a referential action).
  userId  String?
  groupId String?
  user    User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group   Group? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  periodType     String // WEEK | MONTH | QUARTER | YEAR | CUSTOM
  periodStart    DateTime
  periodEnd      DateTime
  recurring      Boolean  @default(false)
  parentBudgetId String?
  parentBudget   Budget?  @relation("BudgetRecurrence", fields: [parentBudgetId], references: [id], onDelete: SetNull)
  instances      Budget[] @relation("BudgetRecurrence")

  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  createdById String

  lines       BudgetLine[]
  assignments BudgetAssignment[]

  @@index([userId, periodStart])
  @@index([groupId, periodStart])
  @@index([parentBudgetId])
}

model BudgetLine {
  id       String @id @default(cuid())
  budgetId String
  budget   Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  categoryId String?
  category   Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  accountId  String?
  account    BankAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  plannedAmount Decimal @db.Decimal(12, 2)
  label         String?

  @@index([budgetId])
}

model BudgetAssignment {
  id            String   @id @default(cuid())
  budgetId      String
  transactionId String
  mode          String // INCLUDE | EXCLUDE
  assignedById  String
  assignedAt    DateTime @default(now())

  budget      Budget      @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([budgetId, transactionId])
  @@index([transactionId])
}
